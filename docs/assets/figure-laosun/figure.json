{
  "manifest": 2,
  "api": 2,
  "id": "laosun",
  "name": {
    "zh": "老孙"
  },
  "about": {
    "zh": "摄影师「老孙不会拍」的 Q 版化身。棕色渔夫帽配垂到胸口的帽绳，黑圆框眼镜，深蓝格纹围巾，橄榄绿格纹粗花呢外套敞开露出灰毛衣，斜挎棕皮小包，深蓝卷边牛仔裤和米白帆布鞋。他站在屏幕底边，走路时双手摆动，被招呼时会举起手挥一挥。"
  },
  "entry": "./figure.js",
  "export": "createLaosunBody",
  "axes": {},
  "presets": {},
  "vocab": [
    { "id": "neutral", "kind": "expression", "names": { "zh": ["平静", "默认"] }, "about": { "zh": "平静自然的表情" }, "seconds": 3.2 },
    { "id": "happy", "kind": "expression", "names": { "zh": ["开心", "高兴", "笑"] }, "about": { "zh": "弯起眼睛微笑，脸颊泛红" }, "seconds": 3.2 },
    { "id": "wink", "kind": "expression", "names": { "zh": ["眨眼", "抛媚眼"] }, "about": { "zh": "单眼眨一下，带笑意" }, "seconds": 2.4 },
    { "id": "love", "kind": "expression", "names": { "zh": ["喜欢", "爱心"] }, "about": { "zh": "眼睛变成爱心，头顶飘出爱心" }, "seconds": 3.2 },
    { "id": "shy", "kind": "expression", "names": { "zh": ["害羞", "不好意思"] }, "about": { "zh": "低头脸红，眼睛缩小" }, "seconds": 3.2 },
    { "id": "surprised", "kind": "expression", "names": { "zh": ["惊讶", "吃惊"] }, "about": { "zh": "睁大眼睛，微微后仰" }, "seconds": 2.4 },
    { "id": "angry", "kind": "expression", "names": { "zh": ["生气", "不高兴"] }, "about": { "zh": "皱眉压眼，身体轻颤" }, "seconds": 3.2 },
    { "id": "sad", "kind": "expression", "names": { "zh": ["难过", "伤心"] }, "about": { "zh": "垂眉含泪，嘴角下撇" }, "seconds": 3.2 },
