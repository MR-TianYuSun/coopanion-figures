    { "id": "thinking", "kind": "expression", "names": { "zh": ["思考", "想想"] }, "about": { "zh": "眼神上飘，头顶冒思考泡" }, "seconds": 4.4 },
    { "id": "smug", "kind": "expression", "names": { "zh": ["得意", "自得"] }, "about": { "zh": "微微斜眼，一副得意的样子" }, "seconds": 3.2 },
    { "id": "pout", "kind": "expression", "names": { "zh": ["嘟嘴", "撇嘴"] }, "about": { "zh": "抿嘴嘟起，视线移开" }, "seconds": 3.2 },
