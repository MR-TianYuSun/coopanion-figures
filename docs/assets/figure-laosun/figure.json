    { "id": "run", "kind": "motion", "names": { "zh": ["跑", "跑步"] }, "about": { "zh": "快速跑动" }, "seconds": 1.2 },
    { "id": "wave", "kind": "motion", "names": { "zh": ["招手", "挥手"] }, "about": { "zh": "举起近侧手挥动" }, "seconds": 1.5 },
    { "id": "bow", "kind": "motion", "names": { "zh": ["鞠躬", "低头行礼"] }, "about": { "zh": "弯腰鞠躬" }, "seconds": 1.6 },
    { "id": "shiver", "kind": "motion", "names": { "zh": ["发抖", "哆嗦"] }, "about": { "zh": "身体轻轻发抖" }, "seconds": 1.5 },
    { "id": "flap", "kind": "motion", "names": { "zh": ["扑腾"] }, "about": { "zh": "手臂快速扑动" }, "seconds": 1.2 },
    { "id": "dance", "kind": "motion", "names": { "zh": ["跳舞", "起舞"] }, "about": { "zh": "左右摇摆跳舞" }, "seconds": 2.0 }
