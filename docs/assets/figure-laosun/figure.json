    { "id": "spin", "kind": "motion", "names": { "zh": ["转圈", "旋转"] }, "about": { "zh": "原地转一圈" }, "seconds": 1.6 },
    { "id": "sit", "kind": "motion", "names": { "zh": ["坐下", "坐"] }, "about": { "zh": "坐到地上，双腿前伸" }, "seconds": 1.0, "lasting": true },
    { "id": "sleep", "kind": "motion", "names": { "zh": ["睡觉", "睡"] }, "about": { "zh": "坐下睡着，冒出 z z" }, "seconds": 2.0, "lasting": true },
    { "id": "dizzy", "kind": "motion", "names": { "zh": ["晕", "头晕"] }, "about": { "zh": "眼冒金星，身体摇晃" }, "seconds": 2.0 },
