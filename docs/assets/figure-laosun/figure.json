    { "id": "look", "kind": "motion", "names": { "zh": ["看", "张望"] }, "about": { "zh": "朝一侧看" }, "seconds": 1.5 },
    { "id": "turn", "kind": "motion", "names": { "zh": ["转身", "转过去"] }, "about": { "zh": "转向另一边" }, "seconds": 1.2 },
