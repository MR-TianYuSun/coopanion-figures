    { "id": "determined", "kind": "expression", "names": { "zh": ["认真", "坚定"] }, "about": { "zh": "目光坚定，眉尾下压" }, "seconds": 3.2 },
    { "id": "flustered", "kind": "expression", "names": { "zh": ["慌张", "手忙脚乱"] }, "about": { "zh": "眼睛乱飘，满脸通红冒汗" }, "seconds": 2.4 },
    { "id": "scared", "kind": "expression", "names": { "zh": ["害怕", "吓到"] }, "about": { "zh": "睁大眼睛发抖" }, "seconds": 2.4 },
    { "id": "excited", "kind": "expression", "names": { "zh": ["期待", "兴奋"] }, "about": { "zh": "眼睛发亮，脸颊微红" }, "seconds": 3.2 },
    { "id": "cry", "kind": "expression", "names": { "zh": ["大哭", "哭"] }, "about": { "zh": "闭眼流泪" }, "seconds": 3.2 },
